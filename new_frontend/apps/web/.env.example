# Copy to .env.local and adjust once the backend is running.

# "false" switches every screen from fixture data onto the real backend.
# Defaults to mock (true) when unset, so the app runs with no backend at all.
VITE_USE_MOCK=true

# Only read when VITE_USE_MOCK=false.
VITE_API_BASE_URL=http://localhost:8000/api/v1
