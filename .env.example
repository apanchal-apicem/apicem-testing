# Postgres - owner role, used by DB init and by the orchestrator/dbt (bypasses RLS by
# default as table owner, which is required to build shared multi-tenant marts).
# Use "localhost" when running backend/orchestrator directly on this machine; docker-compose
# overrides this to the "postgres" service name for its own containers either way.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apicem
POSTGRES_USER=apicem
POSTGRES_PASSWORD=apicem_dev_password

# Postgres - restricted role used ONLY by the backend API. Not a table owner, so Postgres
# always subjects it to RLS policies (see warehouse/sql/004_rls.sql, 005_grants.sh).
APICEM_APP_DB_USER=apicem_app
APICEM_APP_DB_PASSWORD=apicem_app_dev_password

# Backend
JWT_SECRET=change_me_dev_only

# Envelope-encrypts real (non-mock) connection credentials before they're stored in
# app.secrets (doc Sec 2.2, 11). Only required if you connect a real Shopify store instead
# of using the mock-data generator. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate this before any real/production deployment -- never reuse a key that has ever been
# pasted into a chat, ticket, or committed file.
FERNET_KEY=

# Orchestrator: how often each connection is re-synced on its scheduled cadence (doc Sec
# 2.4). A user-triggered "sync now" runs independently of this, within ~30s.
SYNC_INTERVAL_MINUTES=15

# How far back a connection's FIRST sync fetches order/customer history (doc Sec 3.5).
# Code default is 365 if unset; lower this for faster local testing against a real store.
SHOPIFY_INITIAL_BACKFILL_DAYS=90

# Email: leave blank to log password-reset emails to the backend console instead of sending
# (fully functional for local dev). Fill in once a real provider is set up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=onboarding@apicem.local
